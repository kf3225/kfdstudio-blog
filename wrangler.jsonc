{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kfdstudio-blog",
  "main": "./dist/index.js",
  "compatibility_date": "2025-04-03",
  "assets": {
    "directory": "./dist",
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "blog-search-index",
      "preview_id": "blog-search-index-preview"
    }
  ]
}
